{
  "manifest_version": 3,
  "name": "WatchLens - CoordinateWatch AI",
  "version": "1.0.0",
  "description": "Explainable Coordinated Review Intelligence & Signal Scanner for Chrome",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.amazon.com/*",
    "https://*.amazon.in/*",
    "https://*.amazon.co.uk/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WatchLens Review Intelligence",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
